{
  "name": "studio-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader native",
    "deploy:self": "bun run ./scripts/self-deploy.ts",
    "compass:deploy": "bun run ./scripts/compass-deploy.ts",
    "fetch:abi": "bun run ./scripts/fetch-abi.ts",
    "lint": "oxlint --type-aware src scripts --ignore-pattern \"*.mjs\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint",
    "contracts:build": "forge build",
    "contracts:test": "forge test",
    "build": "vite build --configLoader native",
    "test": "vitest run --configLoader native",
    "test:db": "node scripts/test-db.mjs",
    "test:contracts": "node node_modules/@foundry-rs/forge/bin.mjs test",
    "preview": "vite preview --configLoader native --host 127.0.0.1"
  },
  "dependencies": {
    "@circle-fin/adapter-viem-v2": "^1.19.2",
    "@circle-fin/app-kit": "^1.18.0",
    "@circle-fin/developer-controlled-wallets": "^10.8.1",
    "@circle-fin/modular-wallets-core": "^1.0.16",
    "@circle-fin/smart-contract-platform": "^10.8.1",
    "@circle-fin/user-controlled-wallets": "^10.8.1",
    "@circle-fin/w3s-pw-web-sdk": "^1.1.11",
    "@openzeppelin/contracts": "5.6.1",
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/react-query": "^5.62.7",
    "@web3icons/react": "^4.0.0",
    "clsx": "^2.1.1",
    "connectkit": "^1.9.2",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.6.0",
    "viem": "2.57.5",
    "wagmi": "^2.19.5"
  },
  "overrides": {
    "viem": "2.57.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~7.0.2",
    "vite": "^6.0.5",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^3.2.4",
    "jsdom": "^26.1.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/dom": "^10.4.1",
    "@foundry-rs/forge": "1.7.1",
    "@foundry-rs/anvil": "1.7.1",
    "embedded-postgres": "18.4.0-beta.17",
    "pg": "^8.16.3",
    "@types/bun": "^1.3.0"
  }
}
