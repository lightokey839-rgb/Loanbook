# Browser configuration only. Copy to .env locally; never commit populated files.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY
VITE_NETWORK=testnet
VITE_TESTNET_LOANBOOK_ADDRESS=0xe1b52752bf5e6cc64a5f65e485ea35ef7cf7a228
# Leave empty until a reviewed mainnet deployment exists.
VITE_MAINNET_LOANBOOK_ADDRESS=
# For GitHub Pages use /Loanbook/; for a root domain use /.
VITE_BASE_PATH=/
# Edge functions use managed SUPABASE_URL / ANON_KEY / SERVICE_ROLE_KEY.
# Never prefix a service-role key, private key, or RPC credential with VITE_.
# ALLOWED_ORIGINS is a server-side comma-separated HTTPS origin allowlist.
